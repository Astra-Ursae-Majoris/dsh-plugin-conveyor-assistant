{
  "name": "dsh-convey-assistant",
  "version": "0.2.1",
  "description": "Turn a rough draft into intent an AI agent cannot misread — a light bullet summary or a deep intent rewrite, plus clarifying questions — before you send it.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "src"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.2-rc.5 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent-default-model": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astra-Ursae-Majoris/dsh-convey-assistant.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs && node scripts/smoke.mjs",
    "prepack": "node build.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "intent",
    "rewrite",
    "prompt-engineering"
  ],
  "homepage": "https://github.com/Astra-Ursae-Majoris/dsh-convey-assistant#readme",
  "bugs": {
    "url": "https://github.com/Astra-Ursae-Majoris/dsh-convey-assistant/issues"
  }
}
